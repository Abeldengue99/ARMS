# Forcar charset UTF-8 para ficheiros servidos pelo Apache.
Options -Indexes

# ==============================================================================
# SEGURANÇA BÁSICA DE PRODUÇÃO (Bloqueio de Ficheiros Sensíveis)
# ==============================================================================
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(package\.json|package-lock\.json|generate_pdf\.js|.*\.md|.*\.sql)$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^Backend/(bd|backups|scripts)/ - [F,L]
    RewriteRule ^node_modules/ - [F,L]
</IfModule>

AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .svg

# Tipos corretos para assets estaticos.
AddType text/css .css
AddType application/javascript .js
AddType application/json .json
AddType image/svg+xml .svg

# Compatibilidade apos separar a aplicacao em Frontend/ e Backend/.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^$ Frontend/index.html [L]
    RewriteRule ^api/(.*)$ Backend/api/$1 [L,QSA]
    RewriteRule ^Frontend/api/(.*)$ Backend/api/$1 [L,QSA]
    RewriteRule ^(css|js|img|lang)/(.*)$ Frontend/$1/$2 [L,QSA]
    RewriteRule ^([^/]+\.html)$ Frontend/$1 [L,QSA]
</IfModule>

# Compressao de respostas textuais. Reduz o peso inicial de HTML, CSS, JS e JSON.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache apenas para assets estaticos. HTML/PHP continuam sempre frescos.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 180 days"
    ExpiresByType image/png "access plus 180 days"
    ExpiresByType image/jpeg "access plus 180 days"
    ExpiresByType image/gif "access plus 180 days"
    ExpiresByType image/webp "access plus 180 days"
    ExpiresByType image/x-icon "access plus 180 days"
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set X-Permitted-Cross-Domain-Policies "none"

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(svg|png|jpg|jpeg|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=15552000, immutable"
    </FilesMatch>

    <FilesMatch "\.html$">
        Header set Content-Type "text/html; charset=UTF-8"
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# Evitar diretivas como php_value ou ForceType global; podem causar erro 500
# dependendo da configuracao PHP/Apache.

<Files "sw.js">
    Header set Service-Worker-Allowed "/"
</Files>
