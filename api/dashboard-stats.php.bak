<?php
require_once 'db.php';
header('Content-Type: application/json; charset=utf-8');

try {
    // 1. Estatísticas principais
    $stmt1 = $pdo->query("SELECT COUNT(*) as total FROM arms.request");
    $totalPedidos = $stmt1->fetch()['total'] ?? 0;

    $stmt2 = $pdo->query("SELECT COUNT(*) as total FROM arms.request WHERE status IN ('DRAFT', 'SENT', 'RECEIVED', 'CLIENT_RESPONDED')");
    $pedidosAbertos = $stmt2->fetch()['total'] ?? 0;

    $stmt3 = $pdo->query("SELECT COUNT(*) as total FROM arms.request WHERE status NOT IN ('DRAFT', 'SENT')");
    $respondidos = $stmt3->fetch()['total'] ?? 0;
    $taxaResposta = $totalPedidos > 0 ? round(($respondidos / $totalPedidos) * 100) : 0;

    // 2. Pedidos recentes com cliente e área
    $stmt4 = $pdo->query("
        SELECT 
            r.reference, 
            r.status,
            c.name as client_name,
            a.name as area_name,
            r.created_at
        FROM arms.request r
        LEFT JOIN arms.client c ON r.client_id = c.id
        LEFT JOIN arms.area a ON r.area_id = a.id
        ORDER BY r.created_at DESC
        LIMIT 10
    ");
    $recentes = $stmt4->fetchAll() ?? [];

    // 3. Distribuição por área
    $stmt5 = $pdo->query("
        SELECT a.name as area_name, COUNT(r.id) as total
        FROM arms.area a
        LEFT JOIN arms.request r ON a.id = r.area_id
        GROUP BY a.id, a.name
        ORDER BY total DESC
    ");
    $porArea = $stmt5->fetchAll() ?? [];

    // 4. Distribuição por status
    $stmt6 = $pdo->query("
        SELECT status, COUNT(id) as total
        FROM arms.request
        GROUP BY status
        ORDER BY total DESC
    ");
    $porStatus = $stmt6->fetchAll() ?? [];

    // 5. Top clientes
    $stmt7 = $pdo->query("
        SELECT c.name as client_name, COUNT(r.id) as total
        FROM arms.request r
        JOIN arms.client c ON r.client_id = c.id
        GROUP BY c.id, c.name
        ORDER BY total DESC
        LIMIT 5
    ");
    $topClientes = $stmt7->fetchAll() ?? [];

    // 6. Pedidos por mês (últimos 6 meses)
    $stmt8 = $pdo->query("
        SELECT 
            EXTRACT(MONTH FROM r.created_at) as mes_num,
            TO_CHAR(r.created_at, 'Mon') as mes_nome,
            COUNT(r.id) as total
        FROM arms.request r
        WHERE r.created_at >= NOW() - INTERVAL '6 months'
        GROUP BY mes_num, mes_nome
        ORDER BY mes_num ASC
    ");
    $porMes = $stmt8->fetchAll() ?? [];

    echo json_encode([
        'sucesso' => true,
        'kpis' => [
            'total_pedidos' => (int)$totalPedidos,
            'pedidos_abertos' => (int)$pedidosAbertos,
            'taxa_resposta' => (int)$taxaResposta,
            'sla_medio' => '2.4h'
        ],
        'recentes' => $recentes,
        'por_area' => $porArea,
        'por_status' => $porStatus,
        'top_clientes' => $topClientes,
        'por_mes' => $porMes
    ]);

} catch (Exception $e) {
    http_response_code(500);
    echo json_encode(['sucesso' => false, 'erro' => $e->getMessage()]);
}
?>
