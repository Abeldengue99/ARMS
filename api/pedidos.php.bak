<?php
require_once 'db.php';

try {
    $stmt = $pdo->query("
        SELECT 
            r.id,
            r.reference as id_str,
            r.title,
            r.status,
            to_char(r.created_at, 'DD/MM/YYYY') as date,
            a.name as area_name,
            c.name as client_name
        FROM arms.request r
        JOIN arms.area a ON r.area_id = a.id
        JOIN arms.client c ON r.client_id = c.id
        ORDER BY r.created_at DESC
    ");
    
    $pedidos = $stmt->fetchAll();
    
    echo json_encode([
        'sucesso' => true,
        'dados' => $pedidos
    ]);
} catch (Exception $e) {
    echo json_encode([
        'sucesso' => false,
        'erro' => $e->getMessage()
    ]);
}
?>
