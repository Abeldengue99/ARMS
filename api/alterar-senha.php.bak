<?php
require_once 'db.php';
header('Content-Type: application/json; charset=utf-8');

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

if (empty($_SESSION['arms_logado']) || empty($_SESSION['arms_user_id'])) {
    echo json_encode(['sucesso' => false, 'erro' => 'Não autenticado.']);
    exit;
}

$data = json_decode(file_get_contents('php://input'), true);

if (!$data || empty($data['senha_atual']) || empty($data['nova_senha'])) {
    echo json_encode(['sucesso' => false, 'erro' => 'Dados incompletos.']);
    exit;
}

try {
    $userId = $_SESSION['arms_user_id'];
    
    // Buscar senha atual
    $stmt = $pdo->prepare("SELECT password_hash FROM arms.auth_user WHERE id = ?");
    $stmt->execute([$userId]);
    $hashAtualDB = $stmt->fetchColumn();

    if (!$hashAtualDB) {
        echo json_encode(['sucesso' => false, 'erro' => 'Utilizador não encontrado.']);
        exit;
    }

    if (!password_verify($data['senha_atual'], $hashAtualDB)) {
        echo json_encode(['sucesso' => false, 'erro' => 'A senha atual está incorreta.']);
        exit;
    }

    // Gerar novo hash
    $novoHash = password_hash($data['nova_senha'], PASSWORD_BCRYPT, ['cost' => 12]);

    $stmtUpdate = $pdo->prepare("UPDATE arms.auth_user SET password_hash = ? WHERE id = ?");
    $stmtUpdate->execute([$novoHash, $userId]);

    echo json_encode(['sucesso' => true, 'mensagem' => 'Senha alterada com sucesso!']);
} catch (Exception $e) {
    echo json_encode(['sucesso' => false, 'erro' => 'Erro de base de dados: ' . $e->getMessage()]);
}
?>
