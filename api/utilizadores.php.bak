<?php
// Endpoint para listar utilizadores reais do PostgreSQL
require_once 'db.php';

header('Content-Type: application/json; charset=utf-8');

try {
    $stmt = $pdo->query("
        SELECT 
            u.id,
            u.email,
            u.user_type,
            u.is_admin,
            u.is_active,
            p.full_name,
            p.phone
        FROM arms.auth_user u
        LEFT JOIN arms.user_profile p ON u.id = p.user_id
        ORDER BY p.full_name ASC
    ");
    
    $utilizadores = $stmt->fetchAll();

    // Adaptar os nomes dos campos para o que o front-end espera
    foreach ($utilizadores as &$u) {
        $nomePartes = explode(' ', $u['full_name'] ?? 'Sem Nome');
        $u['first_name'] = $nomePartes[0];
        $u['last_name'] = count($nomePartes) > 1 ? end($nomePartes) : '';
    }

    echo json_encode([
        'sucesso' => true,
        'dados' => $utilizadores
    ]);
} catch (Exception $e) {
    echo json_encode([
        'sucesso' => false,
        'erro' => $e->getMessage()
    ]);
}
?>
