<?php
/**
 * ARMS — API para Editar Cliente
 * Atualiza dados de um cliente existente no PostgreSQL
 */
require_once 'db.php';

header('Content-Type: application/json; charset=utf-8');

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    echo json_encode(['sucesso' => false, 'erro' => 'Método não permitido.']);
    exit;
}

$input = json_decode(file_get_contents('php://input'), true);

// Validar campos obrigatórios
if (empty($input['id'])) {
    echo json_encode(['sucesso' => false, 'erro' => 'ID do cliente é obrigatório.']);
    exit;
}

if (empty($input['nome']) || empty($input['email'])) {
    echo json_encode(['sucesso' => false, 'erro' => 'Nome e Email são obrigatórios.']);
    exit;
}

try {
    $pdo->beginTransaction();

    // 1. Atualizar dados do cliente
    $stmt = $pdo->prepare("
        UPDATE arms.client 
        SET name = :nome, 
            primary_email = :email, 
            tax_id = :nif, 
            location = :localizacao,
            is_active = :ativo
        WHERE id = :id
        RETURNING id, name, primary_email, tax_id, location, is_active
    ");

    $stmt->execute([
        'id'           => $input['id'],
        'nome'         => $input['nome'],
        'email'        => $input['email'],
        'nif'          => !empty($input['nif']) ? $input['nif'] : null,
        'localizacao'  => !empty($input['localizacao']) ? $input['localizacao'] : null,
        'ativo'        => isset($input['ativo']) ? ($input['ativo'] ? 'true' : 'false') : 'true'
    ]);

    $clienteAtualizado = $stmt->fetch();

    if (!$clienteAtualizado) {
        $pdo->rollBack();
        echo json_encode(['sucesso' => false, 'erro' => 'Cliente não encontrado.']);
        exit;
    }

    // 2. Atualizar ou criar contacto
    if (!empty($input['contacto_nome'])) {
        $stmtCheck = $pdo->prepare("SELECT id FROM arms.client_contact WHERE client_id = :client_id LIMIT 1");
        $stmtCheck->execute(['client_id' => $input['id']]);
        $contactoExistente = $stmtCheck->fetch();

        if ($contactoExistente) {
            $stmtContacto = $pdo->prepare("
                UPDATE arms.client_contact 
                SET full_name = :full_name, email = :email 
                WHERE id = :id
            ");
            $stmtContacto->execute([
                'id'        => $contactoExistente['id'],
                'full_name' => $input['contacto_nome'],
                'email'     => $input['email']
            ]);
        } else {
            $stmtContacto = $pdo->prepare("
                INSERT INTO arms.client_contact (client_id, email, full_name)
                VALUES (:client_id, :email, :full_name)
            ");
            $stmtContacto->execute([
                'client_id' => $input['id'],
                'email'     => $input['email'],
                'full_name' => $input['contacto_nome']
            ]);
        }
    }

    $pdo->commit();

    echo json_encode([
        'sucesso'  => true,
        'mensagem' => 'Cliente atualizado com sucesso!',
        'cliente'  => $clienteAtualizado
    ]);

} catch (Exception $e) {
    if ($pdo->inTransaction()) $pdo->rollBack();
    echo json_encode([
        'sucesso' => false,
        'erro'    => $e->getMessage()
    ]);
}
?>
