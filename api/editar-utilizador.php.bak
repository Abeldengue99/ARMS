<?php
require_once 'db.php';

header('Content-Type: application/json; charset=utf-8');

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    echo json_encode(['sucesso' => false, 'erro' => 'Método não permitido']);
    exit;
}

$data = json_decode(file_get_contents('php://input'), true);

if (!$data || empty($data['id'])) {
    echo json_encode(['sucesso' => false, 'erro' => 'Dados inválidos']);
    exit;
}

$id = (int)$data['id'];
$firstName = trim($data['first_name'] ?? '');
$lastName = trim($data['last_name'] ?? '');
$email = trim($data['email'] ?? '');
$tipoAcesso = trim($data['tipo_acesso'] ?? 'Aksanti Team');

if (empty($firstName) || empty($email)) {
    echo json_encode(['sucesso' => false, 'erro' => 'Nome e e-mail são obrigatórios.']);
    exit;
}

try {
    $pdo->beginTransaction();

    $userType = ($tipoAcesso === 'Cliente') ? 'CLIENT' : 'AKSANTI';
    
    // Atualizar auth_user (email e tipo)
    $stmtUser = $pdo->prepare("
        UPDATE arms.auth_user 
        SET email = :email, user_type = :type 
        WHERE id = :id
    ");
    $stmtUser->execute([
        ':email' => $email,
        ':type' => $userType,
        ':id' => $id
    ]);
    
    // Atualizar user_profile (nome completo)
    $fullName = trim("$firstName $lastName");
    $stmtProfile = $pdo->prepare("
        UPDATE arms.user_profile 
        SET full_name = :full_name 
        WHERE user_id = :id
    ");
    $stmtProfile->execute([
        ':full_name' => $fullName,
        ':id' => $id
    ]);

    $pdo->commit();
    echo json_encode(['sucesso' => true, 'mensagem' => 'Utilizador atualizado!']);

} catch (PDOException $e) {
    $pdo->rollBack();
    if ($e->getCode() == '23505') {
        echo json_encode(['sucesso' => false, 'erro' => 'Já existe um utilizador com este e-mail.']);
    } else {
        echo json_encode(['sucesso' => false, 'erro' => 'Erro na BD: ' . $e->getMessage()]);
    }
}
?>
