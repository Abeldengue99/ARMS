<?php
// API de Notificações - Listar, Contar e Marcar como Lidas
require_once 'db.php';

header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');

// Determinar ação
$acao = $_GET['acao'] ?? 'listar';

try {
if (session_status() === PHP_SESSION_NONE) {
    session_start();
}

// Verificar se utilizador está logado
if (empty($_SESSION['arms_logado']) || empty($_SESSION['arms_user_id'])) {
    echo json_encode(['sucesso' => false, 'erro' => 'Não autenticado.', 'nao_lidas' => 0]);
    exit;
}

$userId = $_SESSION['arms_user_id'];

    switch ($acao) {
        case 'contar':
            // Contar notificações não lidas
            $stmt = $pdo->prepare("
                SELECT COUNT(*) FROM arms.notification 
                WHERE recipient_id = :uid AND is_read = FALSE
            ");
            $stmt->execute(['uid' => $userId]);
            $count = (int)$stmt->fetchColumn();
            
            echo json_encode(['sucesso' => true, 'nao_lidas' => $count]);
            break;

        case 'marcar_lida':
            // Marcar UMA notificação como lida
            $input = json_decode(file_get_contents('php://input'), true);
            $notifId = $input['id'] ?? null;
            
            if ($notifId) {
                $stmt = $pdo->prepare("
                    UPDATE arms.notification 
                    SET is_read = TRUE, read_at = NOW() 
                    WHERE id = :id AND recipient_id = :uid
                ");
                $stmt->execute(['id' => $notifId, 'uid' => $userId]);
            }
            
            echo json_encode(['sucesso' => true]);
            break;

        case 'marcar_todas':
            // Marcar TODAS como lidas
            $stmt = $pdo->prepare("
                UPDATE arms.notification 
                SET is_read = TRUE, read_at = NOW() 
                WHERE recipient_id = :uid AND is_read = FALSE
            ");
            $stmt->execute(['uid' => $userId]);
            $count = $stmt->rowCount();
            
            echo json_encode(['sucesso' => true, 'marcadas' => $count]);
            break;

        case 'listar':
        default:
            // Listar todas as notificações
            $stmt = $pdo->prepare("
                SELECT 
                    n.id,
                    n.type,
                    n.is_read,
                    n.payload,
                    n.request_id,
                    to_char(n.created_at, 'DD/MM/YYYY, HH24:MI') as data_formatada,
                    n.created_at,
                    r.reference as pedido_ref
                FROM arms.notification n
                LEFT JOIN arms.request r ON n.request_id = r.id
                WHERE n.recipient_id = :uid AND n.channel = 'IN_APP'
                ORDER BY n.created_at DESC
                LIMIT 50
            ");
            $stmt->execute(['uid' => $userId]);
            $notificacoes = $stmt->fetchAll();
            
            // Construir mensagem legível a partir do tipo
            foreach ($notificacoes as &$n) {
                $payload = json_decode($n['payload'] ?? '{}', true);
                $ref = $n['pedido_ref'] ?? '';
                
                switch ($n['type']) {
                    case 'STATUS_CHANGE':
                        $de = $payload['from_status'] ?? '?';
                        $para = $payload['to_status'] ?? '?';
                        $n['message'] = "O pedido $ref mudou de estado: $de → $para";
                        $n['icone'] = 'status';
                        break;
                    case 'DEADLINE':
                        $n['message'] = "O prazo do pedido $ref está a aproximar-se!";
                        $n['icone'] = 'prazo';
                        break;
                    case 'RESPONSE':
                        $n['message'] = "O cliente respondeu ao pedido $ref.";
                        $n['icone'] = 'resposta';
                        break;
                    case 'NEW_REQUEST':
                        $n['message'] = "Foi criado um novo pedido: $ref.";
                        $n['icone'] = 'novo';
                        break;
                    case 'COMMENT':
                        $n['message'] = "Novo comentário no pedido $ref.";
                        $n['icone'] = 'comentario';
                        break;
                    default:
                        $msg = $payload['message'] ?? "Notificação do sistema";
                        $n['message'] = $ref ? "$msg ($ref)" : $msg;
                        $n['icone'] = 'sistema';
                }
            }
            
            // Contar não lidas
            $stmtCount = $pdo->prepare("
                SELECT COUNT(*) FROM arms.notification 
                WHERE recipient_id = :uid AND is_read = FALSE
            ");
            $stmtCount->execute(['uid' => $userId]);
            $naoLidas = (int)$stmtCount->fetchColumn();
            
            echo json_encode([
                'sucesso' => true,
                'dados' => $notificacoes,
                'nao_lidas' => $naoLidas,
                'total' => count($notificacoes)
            ]);
            break;
    }

} catch (Exception $e) {
    echo json_encode(['sucesso' => false, 'erro' => $e->getMessage()]);
}
?>
