<?php
// Endpoint para buscar áreas e clientes do PostgreSQL para preencher os dropdowns do formulário
require_once 'db.php';

header('Content-Type: application/json; charset=utf-8');

try {
    // Buscar todas as áreas activas
    $stmtAreas = $pdo->query("SELECT id, code, name FROM arms.area ORDER BY name ASC");
    $areas = $stmtAreas->fetchAll();

    // Buscar todos os clientes activos
    $stmtClientes = $pdo->query("SELECT id, name, primary_email FROM arms.client WHERE is_active = TRUE ORDER BY name ASC");
    $clientes = $stmtClientes->fetchAll();

    echo json_encode([
        'sucesso' => true,
        'areas' => $areas,
        'clientes' => $clientes
    ]);
} catch (Exception $e) {
    echo json_encode([
        'sucesso' => false,
        'erro' => $e->getMessage()
    ]);
}
?>
