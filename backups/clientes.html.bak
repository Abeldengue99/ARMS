<!DOCTYPE html>
<!-- Estou a abrir o ficheiro que alberga toda a base de dados dos clientes da Aksanti no ecrã (O Listar Clientes) -->
<html lang="pt">
<head>
    <!-- Estou a prevenir que os caracteres fiquem partidos nas janelas com acentuação de pt-pt -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Estou a espetar na aba superior do browser o letreiro para saberes que t?s nos teus Clientes -->
    <title>Clientes - ARMS</title>
    <!-- Script Anti-Flicker: Ocultar imediatamente links admin para clientes usando localStorage antes de renderizar a página -->
    <script>
        try {
            var dados = JSON.parse(localStorage.getItem('arms_utilizador_dados'));
            if (dados && dados.tipo === 'CLIENT') {
                document.documentElement.classList.add('is-client-role');
            }
        } catch(e) {}
    </script>
    <style>
        html.is-client-role .menu-admin-only { display: none !important; }
    </style>

    <!-- Estou a puxar e a vestir todo o corpo disto com as nossas roupas pesadas da base do CSS -->
    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/variaveis.css">
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/componentes.css">
    <link rel="stylesheet" href="css/formularios.css">
    <link rel="stylesheet" href="css/tabelas.css">
    <link rel="stylesheet" href="css/animacoes.css">
    <link rel="stylesheet" href="css/responsivo.css">
</head>
<body>
    
    <!-- Estou a criar e amontoar no mesmo sótio as barras negras laterais (Menu do painel) -->
    <div class="layout-principal">
        
        <aside class="barra-lateral" id="barra-lateral">
            <div class="barra-lateral-logo">
                <img src="img/logo.svg" alt="ARMS" class="logo-svg">
            </div>
            
            <nav style="display: flex; flex-direction: column; gap: 8px; padding: 0 12px;">
                <!-- Estou a matar o brilho ativo do botão "Dashboard" ou "Pedidos", porque já não pertences lá e sim c?! -->
                <a href="dashboard.html" class="menu-item">
                    <span data-i18n="nav.dashboard">Painel de Controlo</span>
                </a>
                <a href="pedidos.html" class="menu-item">
                    <span data-i18n="nav.pedidos">Pedidos</span>
                </a>
                <!-- Estou a acender é for?a bruta as tochas Douradas neste menu. "Tu estás nos teus Clientes! O ativo mora aqui!" -->
                <a href="clientes.html" class="menu-item menu-admin-only activo">
                    <span data-i18n="nav.clientes">Clientes</span>
                </a>
                <a href="areas.html" class="menu-item menu-admin-only">
                    <span data-i18n="nav.areas">Departamentos</span>
                </a>
                
                <hr class="menu-admin-only" style="border-color: #333; margin: 16px 0; border-style: solid; border-width: 1px 0 0 0;">
                
                <a href="admin-utilizadores.html" class="menu-item menu-admin-only">
                    <span data-i18n="nav.admin">Administração</span>
                </a>
                <a href="#" class="menu-item" style="color: #ef4444;" id="btn-sair">
                    <span data-i18n="nav.sair">Terminar Sessão</span>
                </a>
            </nav>
        </aside>

        <!-- Estou a deitar a placa branca do ecrã principal a dominar a vista direita -->
        <main class="area-conteudo" style="min-width: 0; overflow-x: hidden;">
            
            <!-- Estou a fechar a tampa no telhado para colocar ali quem ?s, que lánguas escolhes e as moedas -->
            <header class="cabecalho-principal">
                <div style="display: flex; align-items: center;">
                    <button id="btn-menu-mobile" class="btn-menu-mobile">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                    </button>
                    <!-- Estou a avisar no teto ao tradutor i18n que isto se traduz a ler por "Clientes" -->
                    <h2 style="font-size: 1.25rem;" data-i18n="nav.clientes">Clientes</h2>
                </div>

                <div class="cabecalho-acoes" style="display: flex; align-items: center; gap: 16px;">
                    <a href="notificacoes.html" style="color: var(--texto-secundario); position: relative; text-decoration: none; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background-color: #f4f4f5; transition: var(--transicao);" onmouseover="this.style.backgroundColor='#e4e4e7'" onmouseout="this.style.backgroundColor='#f4f4f5'" title="Notificações">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span style="position: absolute; top: 8px; right: 8px; width: 8px; height: 8px; background-color: var(--cor-perigo); border-radius: 50%; border: 2px solid #f4f4f5;"></span>
                    </a>
                    
                    <a href="perfil.html" style="text-decoration: none;" title="O Meu Perfil">
                        <div style="width: 40px; height: 40px; border-radius: 50%; background-color: var(--aksanti-gold); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.1rem; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" data-arms-avatar>PA</div>
                    </a>

                    <div style="width: 1px; height: 24px; background-color: #e4e4e7; margin: 0 8px;"></div>
                    <select id="select-idioma-aksanti" class="input-controlo" style="width: auto; padding: 6px 12px;">
                        <option value="pt">Português</option>
                        <option value="en">English</option>
                        <option value="fr">Français</option>
                    </select>
                </div>
            </header>

            <div class="conteudo-pagina">
                
                <!-- Estou a arrumar um flex no meio para teres ali espa?o entre o título Clientes e o Bot?o d'Ouro "Adicionar" -->
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2 style="font-size: 1.5rem; color: var(--texto-principal);">Gestão de Clientes</h2>
                    <button id="btn-adicionar-cliente" class="btn btn-primario">Adicionar Cliente</button>
                </div>

                <!-- Estou a convocar aquela animação deslumbrante (Deslize da ISAF) também para estas páginas de grelhas gigantes! -->
                <div class="card deslizar-cima-isaf">
                    
                    <div style="margin-bottom: 20px; display: flex; gap: 16px;">
                        <input type="text" id="filtro-clientes" class="input-controlo" placeholder="Pesquisar Nome ou NIF..." style="max-width: 300px;">
                    </div>

                    <div style="overflow-x: auto;">
                        <table style="width: 100%; text-align: left; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 1px solid #e4e4e7;">
                                    <!-- Estou a puxar nomes diretos na tabela para "Empresa, Identidade, Pessoal para chatear (Contato), e a Ação no fim! -->
                                    <th style="padding: 12px 16px; color: var(--texto-secundario); font-weight: 500;">Empresa</th>
                                    <th style="padding: 12px 16px; color: var(--texto-secundario); font-weight: 500;">NIF</th>
                                    <th style="padding: 12px 16px; color: var(--texto-secundario); font-weight: 500;">Localização</th>
                                    <th style="padding: 12px 16px; color: var(--texto-secundario); font-weight: 500;">Pessoa de Contacto</th>
                                    <th style="padding: 12px 16px; color: var(--texto-secundario); font-weight: 500;" data-i18n="tabela.status">Estado</th>
                                    <th style="padding: 12px 16px; color: var(--texto-secundario); font-weight: 500; text-align: right;" data-i18n="tabela.acoes">Ações</th>
                                </tr>
                            </thead>
                            <!-- Estou a cimentar o buraco (Tbody vazio) para o teu motor de JavaScript das tabelas espetar a tinta lá! -->
                            <tbody id="tabela-corpo-clientes">
                                <!-- O JavaScript vai encher este espa?o com os dados mock dos clientes! -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Estou a colar ao cháo as trancas e fundaãoes das lánguas, e as ligaãoes é navegação das abas -->
    <script src="js/i18n.js"></script>
    <!-- moeda.js removed: currency selector removed -->
    <script src="js/sidebar.js"></script>
    <script src="js/modal.js"></script>
    <!-- O C?rebro do Real-Time Engine para a página de clientes -->
    <script src="js/tempo-real.js"></script>

    <!-- Estou a trazer e invocar o script de manipulação da tela, os teus clientes listados em loops For -->
    <script src="js/clientes.js"></script>

    <script src="js/notificacoes.js"></script>
    <script src="js/app.js"></script>
    
    <script>
        document.getElementById('btn-sair').addEventListener('click', (evento) => {
            evento.preventDefault();
            if (typeof ArmsSessao !== 'undefined') {
                ArmsSessao.terminar();
            } else {
                localStorage.removeItem('arms_utilizador_logado');
                window.location.href = 'index.html';
            }
        });

        // Ligar o modal de adicionar cliente com dados reais do PostgreSQL
        const btnAddCliente = document.getElementById('btn-adicionar-cliente');
        if (btnAddCliente) {
            btnAddCliente.addEventListener('click', () => {
                const formHTML = `
                    <div class="formulario-grid">
                        <div class="largura-total">
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Nome da Empresa <span style="color: var(--cor-perigo);">*</span></label>
                            <input type="text" id="campo-nome-empresa" class="input-controlo" placeholder="Ex: Aksanti Group, Lda.">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Email Principal <span style="color: var(--cor-perigo);">*</span></label>
                            <input type="email" id="campo-email-empresa" class="input-controlo" placeholder="geral@empresa.co.ao">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">NIF</label>
                            <input type="text" id="campo-nif-empresa" class="input-controlo" placeholder="N?mero de Identificação Fiscal">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Localização</label>
                            <input type="text" id="campo-localizacao-empresa" class="input-controlo" placeholder="Ex: Luanda, Angola">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Pessoa de Contacto</label>
                            <input type="text" id="campo-contacto-nome" class="input-controlo" placeholder="Nome do representante">
                        </div>
                    </div>
                    <div id="modal-feedback-cliente" style="display:none; padding: 12px 16px; border-radius: var(--raio-borda); margin-top: 16px; font-size: 0.9rem;"></div>
                    <div class="formulario-acoes">
                        <button class="btn btn-secundario" onclick="fecharModal()">Cancelar</button>
                        <button class="btn btn-primario" id="btn-guardar-cliente">Guardar Cliente</button>
                    </div>
                `;
                abrirModal('Adicionar Novo Cliente', formHTML, { largura: '560px' });

                // Ligar o botão de guardar é API
                document.getElementById('btn-guardar-cliente').addEventListener('click', () => {
                    const feedback = document.getElementById('modal-feedback-cliente');
                    const dados = {
                        nome:          document.getElementById('campo-nome-empresa').value.trim(),
                        email:         document.getElementById('campo-email-empresa').value.trim(),
                        nif:           document.getElementById('campo-nif-empresa').value.trim(),
                        localizacao:   document.getElementById('campo-localizacao-empresa').value.trim(),
                        contacto_nome: document.getElementById('campo-contacto-nome').value.trim()
                    };

                    if (!dados.nome || !dados.email) {
                        feedback.style.display = 'block';
                        feedback.style.backgroundColor = 'rgba(239,68,68,0.1)';
                        feedback.style.color = '#ef4444';
                        feedback.textContent = 'Nome e Email sóo obrigatórios.';
                        return;
                    }

                    feedback.style.display = 'block';
                    feedback.style.backgroundColor = 'rgba(229,138,19,0.1)';
                    feedback.style.color = 'var(--aksanti-gold)';
                    feedback.textContent = 'A guardar cliente...';

                    fetch('api/criar-cliente.php', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(dados)
                    })
                    .then(res => res.json())
                    .then(resultado => {
                        if (resultado.sucesso) {
                            feedback.style.backgroundColor = 'rgba(34,197,94,0.1)';
                            feedback.style.color = '#22c55e';
                            feedback.textContent = '? ' + resultado.mensagem;
                            setTimeout(() => {
                                fecharModal();
                                if (typeof ArmsTempoReal !== 'undefined') {
                                    ArmsTempoReal.forcarAtualizacao();
                                } else {
                                    location.reload();
                                }
                            }, 1500);
                        } else {
                            feedback.style.backgroundColor = 'rgba(239,68,68,0.1)';
                            feedback.style.color = '#ef4444';
                            feedback.textContent = '? Erro: ' + resultado.erro;
                        }
                    })
                    .catch(() => {
                        feedback.style.backgroundColor = 'rgba(239,68,68,0.1)';
                        feedback.style.color = '#ef4444';
                        feedback.textContent = '? Erro de ligação ao servidor.';
                    });
                });
            });
        }

        // -----------------------------------------------------------
        // FUNCIONALIDADE: EDITAR CLIENTE
        // -----------------------------------------------------------
        window.abrirEditarCliente = function(clienteId) {
            // Buscar dados frescos do cliente na API
            fetch('api/clientes.php')
                .then(res => res.json())
                .then(data => {
                    if (!data.sucesso) return;
                    const cliente = data.dados.find(c => c.id === clienteId);
                    if (!cliente) return alert('Cliente não encontrado.');

                    const nifVal = cliente.tax_id === '?' ? '' : cliente.tax_id;
                    const locVal = cliente.location === '?' ? '' : cliente.location;
                    const contactoVal = cliente.contact_name === 'Sem contacto' ? '' : cliente.contact_name;
                    const isAtivo = cliente.status === 'ACTIVE';

                    const formHTML = `
                        <div class="formulario-grid">
                            <div class="largura-total">
                                <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Nome da Empresa <span style="color: var(--cor-perigo);">*</span></label>
                                <input type="text" id="editar-nome" class="input-controlo" value="${cliente.company_name}">
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Email Principal <span style="color: var(--cor-perigo);">*</span></label>
                                <input type="email" id="editar-email" class="input-controlo" value="${cliente.contact_email}">
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">NIF</label>
                                <input type="text" id="editar-nif" class="input-controlo" value="${nifVal}" placeholder="N?mero de Identificação Fiscal">
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Localização</label>
                                <input type="text" id="editar-localizacao" class="input-controlo" value="${locVal}" placeholder="Ex: Luanda, Angola">
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Pessoa de Contacto</label>
                                <input type="text" id="editar-contacto" class="input-controlo" value="${contactoVal}" placeholder="Nome do representante">
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 8px; font-weight: 500; color: var(--texto-principal);">Estado</label>
                                <select id="editar-estado" class="input-controlo">
                                    <option value="true" ${isAtivo ? 'selected' : ''}>Ativo</option>
                                    <option value="false" ${!isAtivo ? 'selected' : ''}>Inativo</option>
                                </select>
                            </div>
                        </div>
                        <div id="modal-feedback-editar" style="display:none; padding: 12px 16px; border-radius: var(--raio-borda); margin-top: 16px; font-size: 0.9rem;"></div>
                        <div class="formulario-acoes">
                            <button class="btn btn-secundario" onclick="fecharModal()">Cancelar</button>
                            <button class="btn btn-primario" id="btn-salvar-edicao">Guardar Alterações</button>
                        </div>
                    `;
                    abrirModal('Editar Cliente', formHTML, { largura: '560px' });

                    // Ligar botão de guardar ediãoo
                    document.getElementById('btn-salvar-edicao').addEventListener('click', () => {
                        const feedback = document.getElementById('modal-feedback-editar');
                        const dados = {
                            id:            clienteId,
                            nome:          document.getElementById('editar-nome').value.trim(),
                            email:         document.getElementById('editar-email').value.trim(),
                            nif:           document.getElementById('editar-nif').value.trim(),
                            localizacao:   document.getElementById('editar-localizacao').value.trim(),
                            contacto_nome: document.getElementById('editar-contacto').value.trim(),
                            ativo:         document.getElementById('editar-estado').value === 'true'
                        };

                        if (!dados.nome || !dados.email) {
                            feedback.style.display = 'block';
                            feedback.style.backgroundColor = 'rgba(239,68,68,0.1)';
                            feedback.style.color = '#ef4444';
                            feedback.textContent = 'Nome e Email sóo obrigatórios.';
                            return;
                        }

                        feedback.style.display = 'block';
                        feedback.style.backgroundColor = 'rgba(229,138,19,0.1)';
                        feedback.style.color = 'var(--aksanti-gold)';
                        feedback.textContent = 'A guardar alterações...';

                        fetch('api/editar-cliente.php', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(dados)
                        })
                        .then(res => res.json())
                        .then(resultado => {
                            if (resultado.sucesso) {
                                feedback.style.backgroundColor = 'rgba(34,197,94,0.1)';
                                feedback.style.color = '#22c55e';
                                feedback.textContent = '? ' + resultado.mensagem;
                                setTimeout(() => {
                                    fecharModal();
                                    if (typeof ArmsTempoReal !== 'undefined') {
                                        ArmsTempoReal.forcarAtualizacao();
                                    } else {
                                        location.reload();
                                    }
                                }, 1500);
                            } else {
                                feedback.style.backgroundColor = 'rgba(239,68,68,0.1)';
                                feedback.style.color = '#ef4444';
                                feedback.textContent = '? Erro: ' + resultado.erro;
                            }
                        })
                        .catch(() => {
                            feedback.style.backgroundColor = 'rgba(239,68,68,0.1)';
                            feedback.style.color = '#ef4444';
                            feedback.textContent = '? Erro de ligação ao servidor.';
                        });
                    });
                });
        };
    </script>
</body>
</html>


