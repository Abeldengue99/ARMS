<!DOCTYPE html>
<!-- Estou a declarar nas pedras de HTML5 que as páginas desta casa se falam base em Português Luso e nada menos que as normas estritas -->
<html lang="pt">

<head>
    <!-- Estou a pedir os carateres puros da Europa sem quebrar os Tildes com o grande padrão global UTF-8 das letras bonitas -->
    <meta charset="UTF-8">
    <!-- Estou a acoplar tudo perfeitamente dimensionado nas largas polegadas num smartphone aos olhos da vossa app, num r?cio de zoom sem quebrar 1/1 -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Estou a pendurar no nome desta página lá nas dobras/Abas lá no alto do Chrome um identificador brutal com título: "ARMS - Painel" -->
    <title>Painel de Controlo - ARMS</title>
    <!-- Script Anti-Flicker: Ocultar imediatamente links admin para clientes usando localStorage antes de renderizar a página -->
    <script>
        try {
            var dados = JSON.parse(localStorage.getItem('arms_utilizador_dados'));
            if (dados && dados.tipo === 'CLIENT') {
                document.documentElement.classList.add('is-client-role');
            }
        } catch (e) { }
    </script>
    <style>
        html.is-client-role .menu-admin-only {
            display: none !important;
        }
    </style>

    <!-- Estou a puxar para as paredes das fachadas as tintas CSS. Reset.css (Limpador base), Variaveis (Cores Douradas), Base (Texto Base Inter), Layout (Barras Laterais Grelhas) e as Animaãoes!  -->
    <link rel="stylesheet" href="css/reset.css?v=2">
    <link rel="stylesheet" href="css/variaveis.css?v=2">
    <link rel="stylesheet" href="css/base.css?v=2">
    <link rel="stylesheet" href="css/layout.css?v=2">
    <link rel="stylesheet" href="css/componentes.css?v=2">
    <link rel="stylesheet" href="css/animacoes.css?v=2">
</head>

<body>

    <!-- Estou a abrir e come?ar do zero com os esqueletos da "classe Layout-Principal", onde o flex e esticar sóo leis para alinhar isto e a app ser gigante com menus e as telas num bloco é volta. -->
    <div class="layout-principal">

        <!-- Estou a enfiar as colunas de cimento no painel escuro é nossa esquerda negra! As paredes pretonas e grossas de 280 da Barra-Lateral. Com um lindo id onde a sidebar e o m?vel se acoplam! -->
        <aside class="barra-lateral" id="barra-lateral">
            <!-- Estou a desenhar na cara na barra de porta para entrada nas listas e opãoes - com padding enorme para respirar nos logos da empresa Aksanti -->
            <div class="barra-lateral-logo">
                <img src="img/logo.svg" alt="ARMS" class="logo-svg">
            </div>

            <!-- Estou a abrir o nosso cofre em gavetas - os botões em listas onde o gajo pica ao clicar das abas! -->
            <nav style="display: flex; flex-direction: column; gap: 8px; padding: 0 12px;">
                <!-- Estou a for?ar aquele primeiro grande Bot?o "ativo com Ouros Gold", pois n?s estamos nela mesmo da sua página a olhar "O dashboard"! E pego no I18n traduzindo a label. -->
                <a href="dashboard.html" class="menu-item activo">
                    <span data-i18n="nav.dashboard">Painel de Controlo</span>
                </a>
                <!-- Estou a amontoar a prateleira em baixo, com a ligação agora a valer a sório para os Pedidos, a dar-lhe apenas as etiquetas "nav.pedidos" sem as ativar de momento com o Dourado -->
                <a href="pedidos.html" class="menu-item">
                    <span data-i18n="nav.pedidos">Pedidos</span>
                </a>
                <!-- Estou a somar a terceira opãoo num clique e é ca?a num nav de "Clientes" ali de cima -->
                <a href="clientes.html" class="menu-item menu-admin-only">
                    <span data-i18n="nav.clientes">Clientes</span>
                </a>
                <!-- Estou a somar a via com nome onde listamos os teus Departamentos da Base ali para gerirem com nome "Areas" na nossa traduãoo -->
                <a href="areas.html" class="menu-item menu-admin-only">
                    <span data-i18n="nav.areas">Departamentos</span>
                </a>

                <!-- Estou a construir nas partes finais da navegação o grande divisor visual para apartar no final das ferramentas na app a "conta do teu utilizador" no baixo, uma linha de separação fininha -->
                <hr class="menu-admin-only"
                    style="border-color: #333; margin: 16px 0; border-style: solid; border-width: 1px 0 0 0;">

                <!-- Estou a engatar lá debaixo nos cliques os botões de Admin que podes acessar em teu poder -->
                <a href="admin-utilizadores.html" class="menu-item menu-admin-only">
                    <span data-i18n="nav.admin">Administração</span>
                </a>
                <!-- Estou a concluir essa porta aos fundos, e um logout perigoso a vermelho se o gajo se atreve a ir "sair" -->
                <a href="#" class="menu-item" style="color: #ef4444;" id="btn-sair">
                    <span data-i18n="nav.sair">Terminar Sessão</span>
                </a>
            </nav>
        </aside>

        <!-- Estou a deitar e a puxar a toalha de toda e extensa "Área de Conte?dos Branca". Fica colada empurrada 280 das margens de lado é grande barra Escura e é infinita! -->
        <main class="area-conteudo" style="min-width: 0; overflow-x: hidden;">

            <!-- Estou a desenhar a tampa / a chapela nas brancas em elevação ligeira nas cabe?as do teu Ecr?. O "Cabecalho-principal", onde habitam no fim das partes as nossas ferramentas e perfis -->
            <header class="cabecalho-principal">
                <!-- Estou a dar num flex ali em display o t?o amado Menu Invisóvel hamburgu?s de telem?veis de lá para as transiãoes se chamarem é tela em que estamos em ?crans abaixo de "1024 px" ! -->
                <div style="display: flex; align-items: center;">
                    <div style="position: relative; margin-left: 0; width: 300px; display: none;"
                        id="barra-pesquisa-topo">
                        <input type="text" id="input-pesquisa-geral" class="input-controlo"
                            placeholder="Pesquisar pedidos..."
                            style="padding-left: 40px; border-radius: 20px; background-color: #f8fafc; border: 1px solid #e2e8f0; width: 100%;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round"
                            style="position: absolute; left: 14px; top: 11px;">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                    </div>
                    <script>
                        // Mostrar barra de pesquisa apenas se não estivermos no telem?vel
                        if (window.innerWidth > 768) {
                            document.getElementById('barra-pesquisa-topo').style.display = 'block';
                        }
                    </script>
                </div>

                <!-- Estou a colocar as duas gavetas das configuraãoes na Extrema Ponta é tua Direita das cabe?as ("No Cabecalho de acoes do CSS que faz alinhado lá a direito") e do seu Perfil -->
                <div class="cabecalho-acoes" style="display: flex; align-items: center; gap: 16px;">
                    <a href="notificacoes.html"
                        style="color: var(--texto-secundario); position: relative; text-decoration: none; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background-color: #f4f4f5; transition: var(--transicao);"
                        onmouseover="this.style.backgroundColor='#e4e4e7'"
                        onmouseout="this.style.backgroundColor='#f4f4f5'" title="Notificações">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                            stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span
                            style="position: absolute; top: 8px; right: 8px; width: 8px; height: 8px; background-color: var(--cor-perigo); border-radius: 50%; border: 2px solid #f4f4f5;"></span>
                    </a>

                    <a href="perfil.html" style="text-decoration: none;" title="O Meu Perfil">
                        <div style="width: 40px; height: 40px; border-radius: 50%; background-color: var(--aksanti-gold); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.1rem; transition: transform 0.2s;"
                            onmouseover="this.style.transform='scale(1.05)'"
                            onmouseout="this.style.transform='scale(1)'" data-arms-avatar>PA</div>
                    </a>

                    <div style="width: 1px; height: 24px; background-color: #e4e4e7; margin: 0 8px;"></div>

                    <!-- Estou a construir o outro buraco das lánguas em Select, puxando os pauzinhos diretamente aos Motores dos nossos ficheiros das Traduções (Fr, En e Pt) a atuar ali em grande -->
                    <select id="select-idioma-aksanti" class="input-controlo" style="width: auto; padding: 6px 12px;">
                        <option value="pt">Português</option>
                        <option value="en">English</option>
                        <option value="fr">Français</option>
                    </select>
                </div>
            </header>

            <!-- Área Principal do Dashboard -->
            <div class="conteudo-pagina">

                <!-- Header ao estilo do Design -->
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 24px;">
                    <div>
                        <h2 style="font-size: 2.2rem; font-weight: 700; color: #1e293b;" data-i18n="nav.dashboard">
                            Dashboard</h2>
                        <p style="color: var(--texto-secundario); font-size: 0.95rem; margin-top: 4px;"
                            id="data-corrente">Corrente m?s, 2024</p>
                    </div>
                </div>

                <!-- Grelha de KPIs -->
                <div
                    style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 32px;">

                    <!-- KPI 1: Total Pedidos -->
                    <div class="card animacao-entrar"
                        style="display: flex; align-items: center; padding: 24px; border-radius: 12px; gap: 16px; border: 1px solid #f1f5f9;">
                        <div
                            style="width: 48px; height: 48px; border-radius: 12px; background-color: #fef3c7; display: flex; align-items: center; justify-content: center; color: #d97706; flex-shrink: 0;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                                <polyline points="10 9 9 9 8 9"></polyline>
                            </svg>
                        </div>
                        <div>
                            <p class="texto-secundario" data-i18n="dashboard.total_pedidos"
                                style="font-size: 0.9rem; font-weight: 600; margin-bottom: 4px;">Total Pedidos</p>
                            <h3 id="kpi-total" style="font-size: 1.75rem; font-weight: 700; color: #1e293b;">...</h3>
                        </div>
                    </div>

                    <!-- KPI 2: Pedidos Abertos -->
                    <div class="card animacao-entrar atraso-1"
                        style="display: flex; align-items: center; padding: 24px; border-radius: 12px; gap: 16px; border: 1px solid #f1f5f9;">
                        <div
                            style="width: 48px; height: 48px; border-radius: 12px; background-color: #fef3c7; display: flex; align-items: center; justify-content: center; color: #d97706; flex-shrink: 0;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14 2 14 8 20 8"></polyline>
                            </svg>
                        </div>
                        <div>
                            <p class="texto-secundario"
                                style="font-size: 0.9rem; font-weight: 600; margin-bottom: 4px;">Pedidos Abertos</p>
                            <h3 id="kpi-abertos" style="font-size: 1.75rem; font-weight: 700; color: #1e293b;">...</h3>
                        </div>
                    </div>

                    <!-- KPI 3: Taxa Resposta -->
                    <div class="card animacao-entrar atraso-2"
                        style="display: flex; align-items: center; padding: 24px; border-radius: 12px; gap: 16px; border: 1px solid #f1f5f9;">
                        <div
                            style="width: 48px; height: 48px; border-radius: 12px; background-color: #fef3c7; display: flex; align-items: center; justify-content: center; color: #d97706; flex-shrink: 0;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <path
                                    d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z">
                                </path>
                            </svg>
                        </div>
                        <div>
                            <p class="texto-secundario" data-i18n="dashboard.taxa_resposta"
                                style="font-size: 0.9rem; font-weight: 600; margin-bottom: 4px;">Taxa de Resposta</p>
                            <h3 id="kpi-taxa" style="font-size: 1.75rem; font-weight: 700; color: #1e293b;">...%</h3>
                        </div>
                    </div>

                    <!-- KPI 4: SLA -->
                    <div class="card animacao-entrar atraso-3"
                        style="display: flex; align-items: center; padding: 24px; border-radius: 12px; gap: 16px; border: 1px solid #f1f5f9;">
                        <div
                            style="width: 48px; height: 48px; border-radius: 12px; background-color: #fef3c7; display: flex; align-items: center; justify-content: center; color: #d97706; flex-shrink: 0;">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                stroke-width="2">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <div>
                            <p class="texto-secundario" data-i18n="dashboard.sla_medio"
                                style="font-size: 0.9rem; font-weight: 600; margin-bottom: 4px;">SLA M?dio</p>
                            <h3 id="kpi-sla" style="font-size: 1.75rem; font-weight: 700; color: #1e293b;">...</h3>
                        </div>
                    </div>
                </div>

                <!-- Secãoo de Gr?ficos Superior: Pedidos por M?s -->
                <div class="card animacao-entrar"
                    style="margin-bottom: 24px; animation-delay: 0.3s; padding: 24px; border: 1px solid #f1f5f9; border-radius: 12px;">
                    <h3 style="font-size: 1.1rem; color: #1e293b; margin-bottom: 16px; font-weight: 600;">Pedidos por
                        M?s</h3>
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="grafico-meses"></canvas>
                    </div>
                </div>

                <!-- Secãoo Inferior: Tabela e Gr?fico Circular -->
                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; margin-bottom: 32px;">

                    <!-- Tabela: Pedidos Recentes -->
                    <div class="card animacao-entrar atraso-3"
                        style="padding: 24px; border: 1px solid #f1f5f9; border-radius: 12px;">
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                            <h3 style="font-size: 1.1rem; color: #1e293b; font-weight: 600;"
                                data-i18n="dashboard.pedidos_recentes">Pedidos Recentes</h3>
                            <a href="pedidos.html"
                                style="color: var(--aksanti-gold); font-weight: 500; font-size: 0.9rem; text-decoration: none;"
                                data-i18n="dashboard.ver_todos">Ver Todos</a>
                        </div>

                        <div style="overflow-x: auto;">
                            <table style="width: 100%; text-align: left; border-collapse: separate; border-spacing: 0;">
                                <thead>
                                    <tr style="background-color: #f8fafc;">
                                        <th style="padding: 12px 16px; color: #475569; font-weight: 600; font-size: 0.85rem; border-radius: 8px 0 0 8px;"
                                            data-i18n="tabela.referencia">Referência</th>
                                        <th style="padding: 12px 16px; color: #475569; font-weight: 600; font-size: 0.85rem;"
                                            data-i18n="tabela.cliente">Cliente</th>
                                        <th style="padding: 12px 16px; color: #475569; font-weight: 600; font-size: 0.85rem;"
                                            data-i18n="tabela.area">Área</th>
                                        <th style="padding: 12px 16px; color: #475569; font-weight: 600; font-size: 0.85rem; border-radius: 0 8px 8px 0;"
                                            data-i18n="tabela.status">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="tabela-corpo-recentes">
                                    <tr>
                                        <td colspan="4"
                                            style="padding: 24px; text-align: center; color: var(--texto-secundario);">A
                                            carregar dados reais...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Gr?fico Circular: Distribuiãoo por Área -->
                    <div class="card animacao-entrar"
                        style="animation-delay: 0.4s; padding: 24px; border: 1px solid #f1f5f9; border-radius: 12px;">
                        <h3 style="font-size: 1.1rem; color: #1e293b; margin-bottom: 24px; font-weight: 600;">
                            Distribuiãoo por Área</h3>
                        <div
                            style="position: relative; height: 250px; width: 100%; display: flex; justify-content: center;">
                            <canvas id="grafico-areas-donut"></canvas>
                        </div>
                    </div>

                </div>

            </div>
        </main>
    </div>

    <!-- Estou a mandar ir invocar as caixas de ferramentas JavaScripts da base (No final de HTML das janelas todas que eu abro). Primeiro aos idiomas globais I18n com ligaãoes ?s lánguas! -->
    <!-- Traduções embutidas (fallback para quando a página é aberta via file:// ou fetch falha) -->
    <script type="application/json" id="lang-pt">{
            "nav": {"dashboard": "Painel de Controlo", "pedidos": "Pedidos", "clientes": "Clientes", "areas": "Departamentos", "notificacoes": "Notificações", "perfil": "O Meu Perfil", "admin": "Administração", "sair": "Terminar Sessão"},
            "dashboard": {"titulo": "Painel de Controlo", "total_pedidos": "Total de Pedidos", "pedidos_abertos": "Pedidos Abertos", "taxa_resposta": "Taxa de Resposta", "sla_medio": "SLA M?dio", "pedidos_recentes": "Pedidos Recentes", "ver_todos": "Ver Todos"},
            "status": {"DRAFT": "Rascunho", "SENT": "Enviado", "RECEIVED": "Recebido", "CLIENT_RESPONDED": "Cliente Respondeu", "ACCEPTED": "Aceite", "REJECTED": "Rejeitado", "CLOSED": "Fechado"},
            "acoes": {"criar_pedido": "Criar Novo Pedido", "guardar": "Guardar Alterações", "cancelar": "Cancelar", "editar": "Editar", "eliminar": "Eliminar", "enviar": "Enviar", "aceitar": "Aceitar", "rejeitar": "Rejeitar", "ver_detalhes": "Ver Detalhes"},
            "tabela": {"referencia": "Referência", "cliente": "Cliente", "area": "Área", "status": "Estado", "data": "Data", "acoes": "Ações"},
            "moeda": {"AOA": "Kwanza", "USD": "D?lar", "EUR": "Euro"}
        }</script>
    <script type="application/json" id="lang-en">{
            "nav": {"dashboard": "Dashboard", "pedidos": "Requests", "clientes": "Clients", "areas": "Departments", "notificacoes": "Notifications", "perfil": "My Profile", "admin": "Administration", "sair": "Sign Out"},
            "dashboard": {"titulo": "Dashboard", "total_pedidos": "Total Requests", "pedidos_abertos": "Open Requests", "taxa_resposta": "Response Rate", "sla_medio": "Average SLA", "pedidos_recentes": "Recent Requests", "ver_todos": "View All"},
            "status": {"DRAFT": "Draft", "SENT": "Sent", "RECEIVED": "Received", "CLIENT_RESPONDED": "Client Responded", "ACCEPTED": "Accepted", "REJECTED": "Rejected", "CLOSED": "Closed"},
            "acoes": {"criar_pedido": "Create New Request", "guardar": "Save Changes", "cancelar": "Cancel", "editar": "Edit", "eliminar": "Delete", "enviar": "Send", "aceitar": "Accept", "rejeitar": "Reject", "ver_detalhes": "View Details"},
            "tabela": {"referencia": "Reference", "cliente": "Client", "area": "Area", "status": "Status", "data": "Date", "acoes": "Actions"},
            "moeda": {"AOA": "Kwanza", "USD": "Dollar", "EUR": "Euro"}
        }</script>
    <script type="application/json" id="lang-fr">{
            "nav": {"dashboard": "Tableau de Bord", "pedidos": "Demandes", "clientes": "Clients", "areas": "D?partements", "notificacoes": "Notifications", "perfil": "Mon Profil", "admin": "Administration", "sair": "Se D?connecter"},
            "dashboard": {"titulo": "Tableau de Bord", "total_pedidos": "Total des Demandes", "pedidos_abertos": "Demandes Ouvertes", "taxa_resposta": "Taux de R?ponse", "sla_medio": "SLA Moyen", "pedidos_recentes": "Demandes R?centes", "ver_todos": "Voir Tout"},
            "status": {"DRAFT": "Brouillon", "SENT": "Envoy?", "RECEIVED": "Re?u", "CLIENT_RESPONDED": "Client a R?pondu", "ACCEPTED": "Accept?", "REJECTED": "Rejet?", "CLOSED": "Ferm?"},
            "acoes": {"criar_pedido": "Cr?er une Nouvelle Demande", "guardar": "Enregistrer les Modifications", "cancelar": "Annuler", "editar": "Modifier", "eliminar": "Supprimer", "enviar": "Envoyer", "aceitar": "Accepter", "rejeitar": "Rejeter", "ver_detalhes": "Voir les D?tails"},
            "tabela": {"referencia": "R?f?rence", "cliente": "Client", "area": "D?partement", "status": "Statut", "data": "Date", "acoes": "Actions"},
            "moeda": {"AOA": "Kwanza", "USD": "Dollar", "EUR": "Euro"}
        }</script>

    <!-- Inclusóo do Chart.js para gr?ficos vivos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="js/i18n.js"></script>
    <!-- Estou a mandar chamar nas nossas bases a acãoo m?vel para as Barras Escondidas com gavetas que andamos no Telem?vel a atuar no JS a partir das telas ali do botão ali ao Hamburger -->
    <script src="js/sidebar.js"></script>

    <!-- Substituindo os scripts mock antigos por chamada real é API (Agora em Tempo Real) -->
    <script src="js/tempo-real.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            let chartMeses = null;
            let chartAreas = null;

            // 1. Data Din?mica em Tempo Real
            const dataCorrenteEl = document.getElementById('data-corrente');
            if (dataCorrenteEl) {
                const dataAtual = new Date();
                const meses = ['Janeiro', 'Fevereiro', 'Mar?o', 'Abril', 'Maio', 'Junho', 'Julho', 'Agosto', 'Setembro', 'Outubro', 'Novembro', 'Dezembro'];
                dataCorrenteEl.textContent = `${meses[dataAtual.getMonth()]}, ${dataAtual.getFullYear()}`;
            }

            // 2. Funcionalidade de Pesquisa 100% Funcional
            const barraPesquisa = document.getElementById('input-pesquisa-geral');
            if (barraPesquisa) {
                barraPesquisa.addEventListener('keyup', (e) => {
                    if (e.key === 'Enter') {
                        const termo = barraPesquisa.value.trim();
                        if (termo) {
                            window.location.href = `pedidos.htmláq=${encodeURIComponent(termo)}`;
                        }
                    } else {
                        // Opcional: Filtrar a pequena tabela de recentes na hora
                        const linhasRecentes = document.querySelectorAll('#tabela-corpo-recentes tr');
                        const termoLower = barraPesquisa.value.toLowerCase();
                        linhasRecentes.forEach(linha => {
                            const texto = linha.textContent.toLowerCase();
                            if (texto.includes(termoLower)) {
                                linha.style.display = '';
                            } else {
                                linha.style.display = 'none';
                            }
                        });
                    }
                });
            }

            ArmsTempoReal.iniciar('dashboard', (data) => {
                // 1. Atualizar KPIs
                if (data.kpis) {
                    const kpis = data.kpis;
                    document.getElementById('kpi-total').textContent = kpis.total_pedidos;
                    document.getElementById('kpi-abertos').textContent = kpis.pedidos_abertos;
                    document.getElementById('kpi-taxa').textContent = kpis.taxa_resposta + '%';
                    document.getElementById('kpi-sla').textContent = kpis.sla_medio;
                }

                // 2. Preencher tabela de pedidos recentes
                const tbody = document.getElementById('tabela-corpo-recentes');
                if (tbody) {
                    tbody.innerHTML = '';
                    if (data.recentes && data.recentes.length > 0) {
                        data.recentes.forEach(r => {
                            const row = document.createElement('tr');
                            let statusClass = 'badge-info';
                            if (r.status === 'ACCEPTED' || r.status === 'CLOSED') statusClass = 'badge-sucesso';
                            if (r.status === 'REJECTED') statusClass = 'badge-perigo';
                            if (r.status === 'DRAFT') statusClass = 'badge-aviso';

                            row.style.cursor = 'pointer';
                            row.onclick = () => window.location.href = `pedido-detalhe.htmláref=${r.reference}`;
                            row.innerHTML = `<td style="padding: 16px; font-weight: 600;">${r.reference}</td>
                                <td style="padding: 16px; color: var(--texto-secundario);">${r.client_name || '?'}</td>
                                <td style="padding: 16px; color: var(--texto-secundario);">${r.area_name || '?'}</td>
                                <td style="padding: 16px;"><span class="badge ${statusClass}" data-i18n="status.${r.status}">${r.status}</span></td>`;
                            tbody.appendChild(row);
                        });
                        if (typeof mudarIdiomaAksanti === 'function') {
                            const idiomaMemorizado = localStorage.getItem('arms_idioma') || 'pt';
                            mudarIdiomaAksanti(idiomaMemorizado);
                        }
                    } else {
                        tbody.innerHTML = '<tr><td colspan="4" style="padding: 24px; text-align: center; color: var(--texto-secundario);">Sem pedidos recentes</td></tr>';
                    }
                }

                // 3. Gr?fico: Pedidos por M?s
                const ctxMeses = document.getElementById('grafico-meses');
                if (ctxMeses && data.por_mes && data.por_mes.length > 0) {
                    const labels = data.por_mes.map(m => m.mes_nome);
                    const valores = data.por_mes.map(m => m.total);

                    if (chartMeses) {
                        chartMeses.data.labels = labels;
                        chartMeses.data.datasets[0].data = valores;
                        chartMeses.update();
                    } else {
                        chartMeses = new Chart(ctxMeses, {
                            type: 'bar',
                            data: {
                                labels: labels,
                                datasets: [{
                                    label: 'Pedidos',
                                    data: valores,
                                    backgroundColor: 'rgba(217, 119, 6, 0.8)',
                                    borderRadius: 6,
                                    borderSkipped: false,
                                    maxBarThickness: 60
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    x: { beginAtZero: true, grid: { color: '#f1f5f9' } },
                                    y: { grid: { display: false } }
                                },
                                plugins: { legend: { display: false } }
                            }
                        });
                    }
                }

                // 4. Gráfico: Distribuição por Área (Doughnut)
                const ctxArea = document.getElementById('grafico-areas-donut');
                if (ctxArea && data.por_area && data.por_area.length > 0) {
                    const areasComDados = data.por_area.filter(a => a.total > 0);
                    if (areasComDados.length > 0) {
                        const cores = ['#3b82f6', '#d97706', '#ef4444', '#10b981', '#6366f1', '#f97316', '#06b6d4', '#8b5cf6'];

                        if (chartAreas) {
                            chartAreas.data.labels = areasComDados.map(a => a.area_name);
                            chartAreas.data.datasets[0].data = areasComDados.map(a => a.total);
                            chartAreas.update();
                        } else {
                            chartAreas = new Chart(ctxArea, {
                                type: 'doughnut',
                                data: {
                                    labels: areasComDados.map(a => a.area_name),
                                    datasets: [{
                                        data: areasComDados.map(a => a.total),
                                        backgroundColor: areasComDados.map((_, i) => cores[i % cores.length]),
                                        borderWidth: 3,
                                        borderColor: '#ffffff',
                                        hoverOffset: 8
                                    }]
                                },
                                options: {
                                    responsive: true,
                                    maintainAspectRatio: false,
                                    cutout: '60%',
                                    plugins: { legend: { display: false } }
                                }
                            });
                        }
                    }
                }
            });

            // Sair do sistema
            document.getElementById('btn-sair')?.addEventListener('click', e => {
                e.preventDefault();
                if (typeof ArmsSessao !== 'undefined') {
                    ArmsSessao.terminar();
                } else {
                    localStorage.removeItem('arms_utilizador_logado');
                    window.location.href = 'index.html';
                }
            });
        });
    </script>

    <!-- Estou a enfiar as botas no teu JS base, nas iniciaãoes dos arranques em "App", certificando me num ecrã limpo a ser sempre logado em n?s ali ou ser o de cima a ir fora para as zonas nas "Logins de Entrada"   -->
    <script src="js/notificacoes.js"></script>
    <script src="js/app.js"></script>

</body>

</html>