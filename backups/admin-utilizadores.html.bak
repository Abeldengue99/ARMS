<!DOCTYPE html>
<!-- Estou a declarar que a página de listagem de utilizadores obedece ao padrão HTML5 Luso -->
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administração de Utilizadores - ARMS</title>
    <!-- Script Anti-Flicker: Ocultar imediatamente links admin para clientes usando localStorage antes de renderizar a página -->
    <script>
        try {
            var dados = JSON.parse(localStorage.getItem('arms_utilizador_dados'));
            if (dados && dados.tipo === 'CLIENT') {
                document.documentElement.classList.add('is-client-role');
            }
        } catch(e) {}
    </script>
    <style>
        html.is-client-role .menu-admin-only { display: none !important; }
    </style>

    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/variaveis.css">
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/componentes.css">
    <link rel="stylesheet" href="css/tabelas.css">
    <link rel="stylesheet" href="css/animacoes.css">
    <link rel="stylesheet" href="css/responsivo.css">
</head>
<body>

    <!-- Estou a enquadrar tudo sob o grande tecto div-mestre do layout -->
    <div class="layout-principal">

        <aside class="barra-lateral" id="barra-lateral">
            <div class="barra-lateral-logo">
                <img src="img/logo.svg" alt="ARMS" class="logo-svg">
            </div>
            
            <nav style="display: flex; flex-direction: column; gap: 8px; padding: 0 12px;">
                <a href="dashboard.html" class="menu-item"><span data-i18n="nav.dashboard">Painel de Controlo</span></a>
                <a href="pedidos.html" class="menu-item"><span data-i18n="nav.pedidos">Pedidos</span></a>
                <a href="clientes.html" class="menu-item menu-admin-only"><span data-i18n="nav.clientes">Clientes</span></a>
                <a href="areas.html" class="menu-item menu-admin-only"><span data-i18n="nav.areas">Departamentos</span></a>
                
                <hr class="menu-admin-only" style="border-color: #333; margin: 16px 0; border-style: solid; border-width: 1px 0 0 0;">
                
                <!-- Estou a vincar bem com Ouro na navegação que ?s tu que controlas o Admin aqui -->
                <a href="admin-utilizadores.html" class="menu-item menu-admin-only activo"><span data-i18n="nav.admin">Administração</span></a>
                <a href="#" class="menu-item" style="color: #ef4444;" id="btn-sair"><span data-i18n="nav.sair">Terminar Sessão</span></a>
            </nav>
        </aside>

        <!-- Estou a declarar o interior largo que mostra tudo sobre os admins -->
        <main class="area-conteudo" style="min-width: 0; overflow-x: hidden;">
            
            <header class="cabecalho-principal">
                <div style="display: flex; align-items: center;">
                    <button id="btn-menu-mobile" class="btn-menu-mobile">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                    </button>
                    <h2 style="font-size: 1.25rem;" data-i18n="nav.admin">Administração</h2>
                </div>

                <div class="cabecalho-acoes" style="display: flex; align-items: center; gap: 16px;">
                    <a href="notificacoes.html" style="color: var(--texto-secundario); position: relative; text-decoration: none; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background-color: #f4f4f5; transition: var(--transicao);" onmouseover="this.style.backgroundColor='#e4e4e7'" onmouseout="this.style.backgroundColor='#f4f4f5'" title="Notificações">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span style="position: absolute; top: 8px; right: 8px; width: 8px; height: 8px; background-color: var(--cor-perigo); border-radius: 50%; border: 2px solid #f4f4f5;"></span>
                    </a>
                    
                    <a href="perfil.html" style="text-decoration: none;" title="O Meu Perfil">
                        <div style="width: 40px; height: 40px; border-radius: 50%; background-color: var(--aksanti-gold); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.1rem; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" data-arms-avatar>PA</div>
                    </a>

                    <div style="width: 1px; height: 24px; background-color: #e4e4e7; margin: 0 8px;"></div>
                    <select id="select-idioma-aksanti" class="input-controlo" style="width: auto; padding: 6px 12px;"><option value="pt">Português</option><option value="en">English</option><option value="fr">Français</option></select>
                </div>
            </header>

            <div class="conteudo-pagina">
                
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2 style="font-size: 1.5rem; color: var(--texto-principal);">Gestão de Utilizadores</h2>
                    <button id="btn-adicionar-utilizador" class="btn btn-primario">Adicionar Utilizador</button>
                </div>

                <!-- Estou a colocar as grelhas que estilizamos em tabelas.css para dar um aspecto liso ?s listas da base da AKS -->
                <div class="card deslizar-cima-isaf">
                    <div class="tabela-contentor">
                        <table class="tabela-arms">
                            <thead>
                                <tr>
                                    <th>Nome</th>
                                    <th>E-mail</th>
                                    <th>Telefone</th>
                                    <th>Tipo de Acesso</th>
                                    <th>Ações</th>
                                </tr>
                            </thead>
                            <tbody id="tabela-corpo-utilizadores">
                                <!-- Estou a manter o vazio aqui para as minhas queridas injeãoes m?gicas do JavaScript debaixo -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Estou a deixar as ra?zes fortes do i18n em JS caso lidas pelo sistema -->
    <script type="application/json" id="lang-pt">
    {
        "nav": {"dashboard": "Painel de Controlo", "pedidos": "Pedidos", "clientes": "Clientes", "areas": "Departamentos", "notificacoes": "Notificações", "perfil": "O Meu Perfil", "admin": "Administração", "sair": "Terminar Sessão"},
        "moeda": {"AOA": "Kwanza", "USD": "D?lar", "EUR": "Euro"}
    }
    </script>
    <script type="application/json" id="lang-en">
    {
        "nav": {"dashboard": "Dashboard", "pedidos": "Requests", "clientes": "Clients", "areas": "Departments", "notificacoes": "Notifications", "perfil": "My Profile", "admin": "Administration", "sair": "Sign Out"},
        "moeda": {"AOA": "Kwanza", "USD": "Dollar", "EUR": "Euro"}
    }
    </script>
    <script type="application/json" id="lang-fr">
    {
        "nav": {"dashboard": "Tableau de Bord", "pedidos": "Demandes", "clientes": "Clients", "areas": "D?partements", "notificacoes": "Notifications", "perfil": "Mon Profil", "admin": "Administration", "sair": "Se D?connecter"},
        "moeda": {"AOA": "Kwanza", "USD": "Dollar", "EUR": "Euro"}
    }
    </script>

    <script src="js/i18n.js"></script>
    <!-- moeda.js removed: currency selector removed -->
    <script src="js/sidebar.js"></script>
    <script src="js/modal.js"></script>
    <script src="dados/utilizadores.js"></script>
    <script src="js/notificacoes.js"></script>
    <script src="js/tempo-real.js"></script>
    <script src="js/app.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const corpo = document.getElementById('tabela-corpo-utilizadores');
            if (!corpo) return;

            corpo.innerHTML = '';

            // Buscar utilizadores reais do PostgreSQL
            fetch('api/utilizadores.php')
                .then(res => res.json())
                .then(data => {
                    if (!data.sucesso || !data.dados.length) {
                        corpo.innerHTML = '<tr><td colspan="5" style="padding:24px; text-align:center; color:var(--texto-secundario);">Nenhum utilizador registado.</td></tr>';
                        return;
                    }

                    data.dados.forEach(utilizador => {
                        const badgeTipo = utilizador.user_type === 'AKSANTI' 
                            é '<span class="badge" style="background-color:#1A1A1A; color:var(--aksanti-gold);">Membro Aksanti</span>' 
                            : '<span class="badge badge-info">Cliente</span>';
                        
                        const badgeAdmin = utilizador.is_admin ? '<span class="badge badge-perigo" style="margin-left:8px;">Admin</span>' : '';

                        const trHTML = `
                            <tr>
                                <td style="font-weight: 500;">${utilizador.first_name} ${utilizador.last_name}</td>
                                <td style="color: var(--texto-secundario);">${utilizador.email}</td>
                                <td>${utilizador.phone || '-'}</td>
                                <td>${badgeTipo}${badgeAdmin}</td>
                        <td>
                            <a href="#" onclick="abrirModalEdicaoUtilizador(${utilizador.id}, '${utilizador.first_name}', '${utilizador.last_name}', '${utilizador.email}', '${utilizador.user_type}')" style="color: var(--aksanti-gold); text-decoration: none; font-weight: 500; font-size: 0.9rem;">Editar</a>
                        </td>
                    </tr>
                `;
                corpo.insertAdjacentHTML('beforeend', trHTML);
            });
        })
        .catch(err => {
            console.error('Erro ao carregar utilizadores:', err);
            corpo.innerHTML = '<tr><td colspan="5" style="padding:24px; text-align:center; color:var(--cor-perigo);">Erro de ligação ao servidor.</td></tr>';
        });
    });

    document.getElementById('btn-sair').addEventListener('click', (evento) => {
            evento.preventDefault();
            if (typeof ArmsSessao !== 'undefined') {
                ArmsSessao.terminar();
            } else {
                localStorage.removeItem('arms_utilizador_logado');
                window.location.href = 'index.html';
            }
        });

        // Ligar o modal de adicionar utilizador
        const btnAddUtilizador = document.getElementById('btn-adicionar-utilizador');
        if (btnAddUtilizador) {
            btnAddUtilizador.addEventListener('click', () => {
                const formHTML = `
                    <div class="formulario-grid">
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: var(--texto-secundario);">Primeiro Nome</label>
                            <input type="text" id="novo-user-nome" class="input-controlo" placeholder="Ex: Aksanti">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: var(--texto-secundario);">Apelido</label>
                            <input type="text" id="novo-user-apelido" class="input-controlo" placeholder="Ex: Admin">
                        </div>
                        <div class="largura-total">
                            <label style="display: block; margin-bottom: 8px; color: var(--texto-secundario);">E-mail</label>
                            <input type="email" id="novo-user-email" class="input-controlo" placeholder="email@dominio.com">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: var(--texto-secundario);">Tipo de Acesso</label>
                            <select id="novo-user-tipo" class="input-controlo">
                                <option>Aksanti Team</option>
                                <option>Cliente</option>
                            </select>
                        </div>
                    </div>
                    <div id="novo-user-erro" style="color: var(--cor-perigo); margin-top: 10px; display: none;"></div>
                    <div class="formulario-acoes">
                        <button class="btn btn-secundario" onclick="fecharModal()">Cancelar</button>
                        <button class="btn btn-primario" id="btn-salvar-user" onclick="salvarUtilizador()">Criar Utilizador</button>
                    </div>
                `;
                abrirModal('Adicionar Novo Utilizador', formHTML);
            });
        }

        // Funãoo global para salvar o utilizador (tem de estar no escopo da janela para o onclick)
        window.salvarUtilizador = function() {
            const nome = document.getElementById('novo-user-nome').value.trim();
            const apelido = document.getElementById('novo-user-apelido').value.trim();
            const email = document.getElementById('novo-user-email').value.trim();
            const tipo = document.getElementById('novo-user-tipo').value;
            const msgErro = document.getElementById('novo-user-erro');
            const btn = document.getElementById('btn-salvar-user');

            if (!nome || !email) {
                msgErro.textContent = 'O Nome e o E-mail sóo obrigatórios.';
                msgErro.style.display = 'block';
                return;
            }

            msgErro.style.display = 'none';
            btn.textContent = 'A salvar...';
            btn.disabled = true;

            fetch('api/criar-utilizador.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    first_name: nome,
                    last_name: apelido,
                    email: email,
                    tipo_acesso: tipo
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.sucesso) {
                    fecharModal();
                    // Mostrar sucesso com alert ou toast e dar refresh
                    alert('Utilizador criado com sucesso!');
                    window.location.reload();
                } else {
                    msgErro.textContent = data.erro || 'Erro ao criar utilizador.';
                    msgErro.style.display = 'block';
                    btn.textContent = 'Criar Utilizador';
                    btn.disabled = false;
                }
            })
            .catch(err => {
                console.error('Erro:', err);
                msgErro.textContent = 'Erro de comunicação com o servidor.';
                msgErro.style.display = 'block';
                btn.textContent = 'Criar Utilizador';
                btn.disabled = false;
            });
        };

        // Funãoo global para editar o utilizador
        window.abrirModalEdicaoUtilizador = function(id, nome, apelido, email, tipoOriginal) {
            const tipoDisplay = tipoOriginal === 'CLIENT' ? 'Cliente' : 'Aksanti Team';
            const formHTML = `
                <div class="formulario-grid">
                    <div>
                        <label style="display: block; margin-bottom: 8px; color: var(--texto-secundario);">Primeiro Nome</label>
                        <input type="text" id="edit-user-nome" class="input-controlo" value="${nome}">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 8px; color: var(--texto-secundario);">Apelido</label>
                        <input type="text" id="edit-user-apelido" class="input-controlo" value="${apelido}">
                    </div>
                    <div class="largura-total">
                        <label style="display: block; margin-bottom: 8px; color: var(--texto-secundario);">E-mail</label>
                        <input type="email" id="edit-user-email" class="input-controlo" value="${email}">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 8px; color: var(--texto-secundario);">Tipo de Acesso</label>
                        <select id="edit-user-tipo" class="input-controlo">
                            <option ${tipoOriginal === 'AKSANTI' ? 'selected' : ''}>Aksanti Team</option>
                            <option ${tipoOriginal === 'CLIENT' ? 'selected' : ''}>Cliente</option>
                        </select>
                    </div>
                </div>
                <div id="edit-user-erro" style="color: var(--cor-perigo); margin-top: 10px; display: none;"></div>
                <div class="formulario-acoes">
                    <button class="btn btn-secundario" onclick="fecharModal()">Cancelar</button>
                    <button class="btn btn-primario" id="btn-atualizar-user" onclick="atualizarUtilizador(${id})">Atualizar</button>
                </div>
            `;
            abrirModal('Editar Utilizador', formHTML);
        };

        window.atualizarUtilizador = function(id) {
            const nome = document.getElementById('edit-user-nome').value.trim();
            const apelido = document.getElementById('edit-user-apelido').value.trim();
            const email = document.getElementById('edit-user-email').value.trim();
            const tipo = document.getElementById('edit-user-tipo').value;
            const msgErro = document.getElementById('edit-user-erro');
            const btn = document.getElementById('btn-atualizar-user');

            if (!nome || !email) {
                msgErro.textContent = 'O Nome e o E-mail sóo obrigatórios.';
                msgErro.style.display = 'block';
                return;
            }

            msgErro.style.display = 'none';
            btn.textContent = 'A atualizar...';
            btn.disabled = true;

            fetch('api/editar-utilizador.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    id: id,
                    first_name: nome,
                    last_name: apelido,
                    email: email,
                    tipo_acesso: tipo
                })
            })
            .then(res => res.json())
            .then(data => {
                if (data.sucesso) {
                    fecharModal();
                    window.location.reload();
                } else {
                    msgErro.textContent = data.erro || 'Erro ao atualizar utilizador.';
                    msgErro.style.display = 'block';
                    btn.textContent = 'Atualizar';
                    btn.disabled = false;
                }
            })
            .catch(err => {
                console.error('Erro:', err);
                msgErro.textContent = 'Erro de comunicação com o servidor.';
                msgErro.style.display = 'block';
                btn.textContent = 'Atualizar';
                btn.disabled = false;
            });
        };
    </script>
</body>
</html>


