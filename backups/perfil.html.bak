<!DOCTYPE html>
<!-- Estou a declarar o c?digo de marcação standard da plataforma ARMS e colocar em PT -->
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perfil - ARMS</title>
    <!-- Script Anti-Flicker: Ocultar imediatamente links admin para clientes usando localStorage antes de renderizar a página -->
    <script>
        try {
            var dados = JSON.parse(localStorage.getItem('arms_utilizador_dados'));
            if (dados && dados.tipo === 'CLIENT') {
                document.documentElement.classList.add('is-client-role');
            }
        } catch(e) {}
    </script>
    <style>
        html.is-client-role .menu-admin-only { display: none !important; }
    </style>

    <link rel="stylesheet" href="css/reset.css">
    <link rel="stylesheet" href="css/variaveis.css">
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/componentes.css">
    <link rel="stylesheet" href="css/formularios.css">
    <link rel="stylesheet" href="css/animacoes.css">
    <link rel="stylesheet" href="css/responsivo.css">
</head>
<body>

    <!-- Estou a iniciar o modelo base da plataforma -->
    <div class="layout-principal">

        <aside class="barra-lateral" id="barra-lateral">
            <div class="barra-lateral-logo">
                <img src="img/logo.svg" alt="ARMS" class="logo-svg">
            </div>
            
            <nav style="display: flex; flex-direction: column; gap: 8px; padding: 0 12px;">
                <a href="dashboard.html" class="menu-item"><span data-i18n="nav.dashboard">Painel de Controlo</span></a>
                <a href="pedidos.html" class="menu-item"><span data-i18n="nav.pedidos">Pedidos</span></a>
                <a href="clientes.html" class="menu-item menu-admin-only"><span data-i18n="nav.clientes">Clientes</span></a>
                <a href="areas.html" class="menu-item menu-admin-only"><span data-i18n="nav.areas">Departamentos</span></a>
                
                <hr class="menu-admin-only" style="border-color: #333; margin: 16px 0; border-style: solid; border-width: 1px 0 0 0;">
                
                <!-- Estou a destacar que o utilizador está exatamente nesta página do seu perfil -->
                <a href="admin-utilizadores.html" class="menu-item menu-admin-only"><span data-i18n="nav.admin">Administração</span></a>
                <a href="#" class="menu-item" style="color: #ef4444;" id="btn-sair"><span data-i18n="nav.sair">Terminar Sessão</span></a>
            </nav>
        </aside>

        <!-- Estou a puxar a fatia do lado direito para colocarmos os dados de perfil da pessoa -->
        <main class="area-conteudo" style="min-width: 0; overflow-x: hidden;">
            
            <header class="cabecalho-principal">
                <div style="display: flex; align-items: center;">
                    <button id="btn-menu-mobile" class="btn-menu-mobile">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
                    </button>
                    <h2 style="font-size: 1.25rem;" data-i18n="nav.perfil">O Meu Perfil</h2>
                </div>

                <div class="cabecalho-acoes" style="display: flex; align-items: center; gap: 16px;">
                    <a href="notificacoes.html" style="color: var(--texto-secundario); position: relative; text-decoration: none; display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background-color: #f4f4f5; transition: var(--transicao);" onmouseover="this.style.backgroundColor='#e4e4e7'" onmouseout="this.style.backgroundColor='#f4f4f5'" title="Notificações">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span style="position: absolute; top: 8px; right: 8px; width: 8px; height: 8px; background-color: var(--cor-perigo); border-radius: 50%; border: 2px solid #f4f4f5;"></span>
                    </a>
                    
                    <a href="perfil.html" style="text-decoration: none;" title="O Meu Perfil">
                        <div style="width: 40px; height: 40px; border-radius: 50%; background-color: var(--aksanti-gold); display: flex; align-items: center; justify-content: center; color: white; font-weight: bold; font-size: 1.1rem; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" data-arms-avatar>PA</div>
                    </a>

                    <div style="width: 1px; height: 24px; background-color: #e4e4e7; margin: 0 8px;"></div>
                    <select id="select-idioma-aksanti" class="input-controlo" style="width: auto; padding: 6px 12px;"><option value="pt">Português</option><option value="en">English</option><option value="fr">Français</option></select>
                </div>
            </header>

            <div class="conteudo-pagina">
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; max-width: 1000px; margin: 0 auto;">
                    <div class="card deslizar-cima-isaf">
                        <h3 class="titulo-secao" style="margin-bottom: 24px;">Dados Pessoais</h3>
                        <div class="grupo-formulario"><label class="etiqueta-formulario">Nome Completo</label><input type="text" class="input-controlo" id="perfil-nome" readonly style="background-color: #f8fafc; color: var(--texto-secundario); cursor: not-allowed;"></div>
                        <div class="grupo-formulario"><label class="etiqueta-formulario">Endere?o de Email</label><input type="text" class="input-controlo" id="perfil-email" readonly style="background-color: #f8fafc; color: var(--texto-secundario); cursor: not-allowed;"></div>
                        <div class="grupo-formulario"><label class="etiqueta-formulario">Tipo de Conta</label><input type="text" class="input-controlo" id="perfil-tipo" readonly style="background-color: #f8fafc; color: var(--texto-secundario); cursor: not-allowed; text-transform: uppercase;"></div>
                        <p style="font-size: 0.85rem; color: var(--texto-secundario); margin-top: 16px;">Para alterar dados pessoais, por favor contacte a administração.</p>
                    </div>
                    <div class="card deslizar-cima-isaf" style="animation-delay: 0.1s;">
                        <h3 class="titulo-secao" style="margin-bottom: 24px;">Seguran?a</h3>
                        <form id="form-alterar-senha" onsubmit="event.preventDefault(); window.alterarSenha();">
                            <div class="grupo-formulario"><label class="etiqueta-formulario">Senha Atual</label><input type="password" class="input-controlo" id="senha-atual" required minlength="6"></div>
                            <div class="grupo-formulario"><label class="etiqueta-formulario">Nova Senha</label><input type="password" class="input-controlo" id="nova-senha" required minlength="6"></div>
                            <div class="grupo-formulario"><label class="etiqueta-formulario">Confirmar Nova Senha</label><input type="password" class="input-controlo" id="confirmar-senha" required minlength="6"></div>
                            <div style="display: flex; justify-content: flex-end; margin-top: 24px;"><button type="submit" class="btn btn-primario" id="btn-salvar-senha" style="width: 100%; justify-content: center;">Alterar Senha</button></div>
                        </form>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Estou a deixar cair as traduções directas aqui dentro -->
    <script type="application/json" id="lang-pt">
    {
        "nav": {"dashboard": "Painel de Controlo", "pedidos": "Pedidos", "clientes": "Clientes", "areas": "Departamentos", "notificacoes": "Notificações", "perfil": "O Meu Perfil", "admin": "Administração", "sair": "Terminar Sessão"},
        "acoes": {"guardar": "Guardar Alterações"},
        "moeda": {"AOA": "Kwanza", "USD": "D?lar", "EUR": "Euro"}
    }
    </script>
    <script type="application/json" id="lang-en">
    {
        "nav": {"dashboard": "Dashboard", "pedidos": "Requests", "clientes": "Clients", "areas": "Departments", "notificacoes": "Notifications", "perfil": "My Profile", "admin": "Administration", "sair": "Sign Out"},
        "acoes": {"guardar": "Save Changes"},
        "moeda": {"AOA": "Kwanza", "USD": "Dollar", "EUR": "Euro"}
    }
    </script>
    <script type="application/json" id="lang-fr">
    {
        "nav": {"dashboard": "Tableau de Bord", "pedidos": "Demandes", "clientes": "Clients", "areas": "D?partements", "notificacoes": "Notifications", "perfil": "Mon Profil", "admin": "Administration", "sair": "Se D?connecter"},
        "acoes": {"guardar": "Enregistrer les Modifications"},
        "moeda": {"AOA": "Kwanza", "USD": "Dollar", "EUR": "Euro"}
    }
    </script>

    <script src="js/i18n.js"></script>
    <!-- moeda.js removed: currency selector removed -->
    <script src="js/sidebar.js"></script>
    <script src="dados/utilizadores.js"></script>
    <script src="js/notificacoes.js"></script>
    <script src="js/tempo-real.js"></script>
    <script src="js/app.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Apenas tentamos injetar dinamicamente se a variavel existir das falsas contas
            if (typeof mockUtilizadores !== 'undefined') {
                const admin = mockUtilizadores[0];
                if (admin) {
                    document.getElementById('perfil-nome').value = admin.first_name + ' ' + admin.last_name;
                    document.getElementById('perfil-email').value = admin.email;
                }
            } else {
                try {
                    const dados = JSON.parse(localStorage.getItem('arms_utilizador_dados'));
                    if (dados) {
                        document.getElementById('perfil-nome').value = dados.nome || '';
                        document.getElementById('perfil-email').value = dados.email || '';
                        document.getElementById('perfil-tipo').value = dados.tipo === 'AKSANTI' ? 'Colaborador Aksanti' : 'Cliente Externo';
                    }
                } catch(e) {}
            }
        });


        window.alterarSenha = function() {
            const atual = document.getElementById('senha-atual').value;
            const nova = document.getElementById('nova-senha').value;
            const confirmar = document.getElementById('confirmar-senha').value;

            if (nova !== confirmar) {
                alert('A nova senha e a confirmação não coincidem.');
                return;
            }

            const btn = document.getElementById('btn-salvar-senha');
            btn.textContent = 'Aguarde...';
            btn.disabled = true;

            fetch('api/alterar-senha.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ senha_atual: atual, nova_senha: nova })
            })
            .then(r => r.json())
            .then(data => {
                btn.textContent = 'Alterar Senha';
                btn.disabled = false;
                if (data.sucesso) {
                    alert(data.mensagem);
                    document.getElementById('form-alterar-senha').reset();
                } else {
                    alert('Erro: ' + data.erro);
                }
            })
            .catch(err => {
                btn.textContent = 'Alterar Senha';
                btn.disabled = false;
                alert('Erro de comunicação com o servidor.');
            });
        };
        document.getElementById('btn-sair').addEventListener('click', (evento) => {
            evento.preventDefault();
            if (typeof ArmsSessao !== 'undefined') {
                ArmsSessao.terminar();
            } else {
                localStorage.removeItem('arms_utilizador_logado');
                window.location.href = 'index.html';
            }
        });
    </script>
</body>
</html>




